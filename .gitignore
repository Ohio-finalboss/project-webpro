# Dependencies (install with npm install / npm ci)
node_modules/

# Environment variables and local secrets
.env
.env.*
!.env.example

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# Test and coverage output
coverage/
.nyc_output/

# Build output and temporary files
dist/
build/
tmp/
temp/

# Operating system and editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# SQLite transient files; keep the actual .db files tracked
*.db-journal
*.db-wal
*.db-shm
